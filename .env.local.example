# Configuration SEO et Analytics pour Rahico Auto
# Copiez ce fichier vers .env.local et remplissez avec vos vraies valeurs

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification Code
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code-here

# URL du site (pour production)
SITE_URL=https://rahico-auto.com

# Configuration Airtable
AIRTABLE_API_KEY=your-airtable-api-key
AIRTABLE_BASE_ID=your-airtable-base-id
AIRTABLE_TABLE_NAME=Cars
